# PostgreSQL Database connection string
# For local development with Docker:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/janamen?sslmode=disable
# For Supabase Direct (IPv6 / local):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres
# For Supabase Pooler (Cloud Run / IPv4):
# DATABASE_URL=postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

